# ---------------------------------------------------------------------------
# Template only. Copy to .env, fill in REAL values, then: chmod 600 .env
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and must NEVER be committed. This file must contain
# placeholders ONLY — no real IPs, no real tailnet name, no real secrets.
# ---------------------------------------------------------------------------

# --- pinned image versions -------------------------------------------------
FORGEJO_VERSION=15.0.6
POSTGRES_VERSION=17-alpine

# --- network binding -------------------------------------------------------
# LAN_IP: this host's address on the home subnet. Set a DHCP reservation for
#   this MAC on the router, or the container will fail to start after the
#   lease changes.  e.g. 192.168.x.x
LAN_IP=192.168.x.x
# TS_IP: this host's Tailscale IPv4 (`tailscale ip -4`). Stable per node.
TS_IP=100.x.x.x
# LAN subnet in CIDR form, used by scripts/firewall.sh.  e.g. 192.168.x.0/24
LAN_SUBNET=192.168.x.0/24

# --- Forgejo identity ------------------------------------------------------
# The tailnet name is the canonical URL because it resolves both at home and
# away, and it is the only path with a real TLS certificate.
FORGEJO_DOMAIN=REPLACE_ME_MACHINE.REPLACE_ME_TAILNET.ts.net
FORGEJO_ROOT_URL=https://REPLACE_ME_MACHINE.REPLACE_ME_TAILNET.ts.net/
FORGEJO_SSH_DOMAIN=REPLACE_ME_MACHINE.REPLACE_ME_TAILNET.ts.net
# Distinct from the host's own sshd so the two never collide.
FORGEJO_SSH_PORT=2222

# --- database --------------------------------------------------------------
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=REPLACE_ME_GENERATE_RANDOM

# --- Forgejo secrets -------------------------------------------------------
# Generate both: docker run --rm codeberg.org/forgejo/forgejo:15.0.6 forgejo generate secret SECRET_KEY
#                docker run --rm codeberg.org/forgejo/forgejo:15.0.6 forgejo generate secret INTERNAL_TOKEN
FORGEJO_SECRET_KEY=REPLACE_ME_GENERATE_RANDOM
FORGEJO_INTERNAL_TOKEN=REPLACE_ME_GENERATE_RANDOM

# --- restic backup target --------------------------------------------------
# Pick ONE of the three blocks below. Credentials must be scoped to a single
# bucket; never use a master/account key.
#
# scripts/setup-r2.sh configures the Cloudflare R2 option for you and proves
# the result with a real restore test.

# (a) Cloudflare R2 -- 10 GB free, zero egress fees.
#     AWS_DEFAULT_REGION=auto is REQUIRED. R2 has no meaningful region, but
#     omitting it produces opaque SigV4 signing errors rather than a clear one.
#     The account ID is a 32-character hex string, NOT your email address.
RESTIC_REPOSITORY=s3:https://REPLACE_ME_ACCOUNT_ID.r2.cloudflarestorage.com/REPLACE_ME_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_ME_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_ME_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto

# (b) Backblaze B2 -- 10 GB free, no credit card required to sign up.
#RESTIC_REPOSITORY=b2:REPLACE_ME_BUCKET:forgejo
#B2_ACCOUNT_ID=REPLACE_ME_B2_KEY_ID
#B2_ACCOUNT_KEY=REPLACE_ME_B2_APPLICATION_KEY

# (c) Local path -- protects against deletion and bad upgrades, but NOT
#     against disk failure, theft or fire. Not a substitute for offsite.
#RESTIC_REPOSITORY=/var/backups/forgejo/restic

# --- restic repository password --------------------------------------------
# !!! Generate with: openssl rand -base64 48
# !!! STORE THIS IN A PASSWORD MANAGER OFF THIS MACHINE.
# !!! If this machine dies and this password exists nowhere else, every backup
# !!! is permanently unrecoverable. There is no reset, no recovery, no support
# !!! channel. This is the single most important line in this file.
RESTIC_PASSWORD=REPLACE_ME_GENERATE_RANDOM

# Set true when the backup target is immutable (e.g. an R2 bucket lock).
# forget/prune delete objects, which a lock forbids, so they are skipped.
# The trade: a compromised forge cannot destroy history, and nothing is ever
# reclaimed automatically.
RESTIC_APPEND_ONLY=false

# --- retention -------------------------------------------------------------
# Hourly granularity must be kept explicitly when backing up hourly;
# --keep-daily alone discards every intra-day snapshot.
RETENTION_HOURLY=48
RETENTION_DAILY=14
RETENTION_WEEKLY=8
RETENTION_MONTHLY=12

# --- alerting thresholds ---------------------------------------------------
# Alert if the newest snapshot is older than this. Must track the backup
# schedule: hourly backups mean a healthy gap is ~1h, so 3h catches a stall
# fast without false alarms. Raise it if you move to a nightly schedule.
BACKUP_MAX_AGE_HOURS=3

# Warn when the data volume crosses this percentage.
DISK_WARN_PCT=80

# Warn when the restic repo nears the provider's free-tier ceiling (bytes).
# 8 GiB leaves headroom under the 10 GB free tiers of both R2 and B2.
RESTIC_WARN_BYTES=8589934592
