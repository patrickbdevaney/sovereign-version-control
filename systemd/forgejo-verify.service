[Unit]
Description=Weekly restic deep verification (reads actual pack data)
After=docker.service
OnFailure=forgejo-alert@%n.service

[Service]
Type=oneshot
# `restic check` alone validates structure only. --read-data-subset actually
# reads and re-hashes a slice of the pack files, which is what catches silent
# corruption. 10% weekly covers the whole repository over ~10 weeks.
# Prune first, then verify. backup.sh deliberately runs `forget` WITHOUT
# --prune (it would repack every hour), so this is where forgotten snapshots
# actually stop consuming space.
# Prune is skipped when the target is immutable (RESTIC_APPEND_ONLY=true):
# it deletes pack files, which a bucket lock forbids, so running it would fail
# the unit every week rather than reclaiming anything.
ExecStart=/bin/bash -c 'set -a; . __REPO_ROOT__/.env; set +a; [ "${RESTIC_APPEND_ONLY:-false}" = "true" ] && { echo "append-only: skipping prune"; exit 0; }; restic prune'
ExecStart=/bin/bash -c 'set -a; . __REPO_ROOT__/.env; set +a; exec restic check --read-data-subset=10%%'
User=root
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=6h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
